<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="service\**" />
    <None Remove="service\**" />
    <Content Remove="service\**" />
    <EmbeddedResource Remove="service\**" />
    <Compile Remove="server\**" />
    <None Remove="server\**" />
    <Content Remove="server\**" />
    <EmbeddedResource Remove="server\**" />
    <Compile Remove="client\**" />
    <None Remove="client\**" />
    <Content Remove="client\**" />
    <EmbeddedResource Remove="client\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="service\BusGrpc.Services.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2592.41" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="example\map.html">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <TargetPath>map.html</TargetPath>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>


</Project>
